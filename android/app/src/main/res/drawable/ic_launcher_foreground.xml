<?xml version="1.0" encoding="utf-8"?>
<!--
    The Relay mark: a signal leaving one point, arcing across, and arriving at
    another, with the packet drawn at the apex.

    Laid out directly in the 108dp adaptive-icon viewport rather than scaled
    from a 512px master, so the geometry is exact at the size it is actually
    drawn. The ink spans x 25.5–82.5 and y 40–68.5, which sits inside the
    66dp safe circle every launcher mask is guaranteed to keep, and is
    optically centred on 54,54 rather than merely bounding-box centred.

    Solid colours on purpose. A gradient is invisible at 48dp and only adds a
    way for the build to break.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- the relayed arc -->
    <path
        android:pathData="M32,62 C32,37 76,37 76,62"
        android:strokeColor="#4ADFBF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />

    <!-- the two ends it travels between -->
    <path
        android:pathData="M32,62 m-6.5,0 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0"
        android:fillColor="#4ADFBF" />
    <path
        android:pathData="M76,62 m-6.5,0 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0"
        android:fillColor="#4ADFBF" />

    <!-- the packet in flight: a node punched out of the arc -->
    <path
        android:pathData="M54,43.25 m-6.4,0 a6.4,6.4 0 1,0 12.8,0 a6.4,6.4 0 1,0 -12.8,0"
        android:fillColor="#0A0C10" />
    <path
        android:pathData="M54,43.25 m-3.6,0 a3.6,3.6 0 1,0 7.2,0 a3.6,3.6 0 1,0 -7.2,0"
        android:fillColor="#BFFBEC" />
</vector>
