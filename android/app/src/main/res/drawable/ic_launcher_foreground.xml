<?xml version="1.0" encoding="utf-8"?>
<!--
    The mark: one span carrying something from one side to the other.

    Four detail treatments were tried on top of this arc and every one of them
    introduced a second reading — terminal circles wider than the stroke made it
    a bone, the same circles with darker centres made a face, a bead at the apex
    sat on it like an ornament, and an aperture punched through it read as a
    keyhole. The arc alone is the mark, and at 48dp it is the only version that
    still says what the product does.

    Laid out directly in the 108dp viewport. Ink spans x 23.8–84.2 and
    y 35.8–72.7, inside the 66dp circle every launcher mask keeps, and optically
    centred on 54,54 rather than merely bounding-box centred.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Contact shadow. Android vectors have no blur, so this is a slightly
         wider stroke of the same path, offset down and held at low alpha. It
         reads as the mark sitting on the surface rather than floating over it. -->
    <path
        android:pathData="M29.5,68.4 C29.5,34.4 78.5,34.4 78.5,68.4"
        android:strokeColor="#3D04413F"
        android:strokeWidth="12.6"
        android:strokeLineCap="round" />

    <!-- The face. Brighter where the light lands, cooling into shadow — never
         a flat white, which is what makes it read as a solid rather than a
         cut-out. -->
    <path
        android:pathData="M29.5,67 C29.5,33 78.5,33 78.5,67"
        android:strokeWidth="11.4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="16"
                android:startY="30"
                android:endX="86"
                android:endY="74">
                <item android:offset="0"    android:color="#FFFFFFFF" />
                <item android:offset="0.55" android:color="#FFFBFFFE" />
                <item android:offset="1"    android:color="#FFD9F7F0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The lit top edge: a thin bright stroke riding the crown of the arc. -->
    <path
        android:pathData="M32.6,60 C33.6,38.6 74.4,38.6 75.4,60"
        android:strokeColor="#59FFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />
</vector>
