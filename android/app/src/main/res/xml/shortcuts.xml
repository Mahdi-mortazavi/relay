<?xml version="1.0" encoding="utf-8"?>
<!--
    Long-press the launcher icon and the one thing anyone opens Relay to do is
    already there. Static rather than dynamic on purpose: it is available from
    the moment the app is installed, before it has ever been opened, which is
    exactly when someone is still learning where things are.

    The action is handled in MainActivity, which starts sharing and shows the
    code — not a second, headless path into the service. One way in means one
    place where the notification permission, the VPN warning and the error
    states are handled.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="start-sharing"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_start"
        android:shortcutShortLabel="@string/shortcut_start_short"
        android:shortcutLongLabel="@string/shortcut_start_long">
        <intent
            android:action="io.relay.app.action.START_SHARING"
            android:targetPackage="io.relay.app"
            android:targetClass="io.relay.app.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
