    <string name="advanced_logs_empty">هنوز فعالیتی نیست</string>

    <!-- Errors (codes: docs/errors.md) -->
    <string name="error_hotspot_off_title">وای‌فای یا هات‌اسپات نیست</string>
    <string name="error_hotspot_off_body">گوشی را به وای‌فای وصل کنید یا هات‌اسپات را روشن کنید و دوباره تلاش کنید.</string>
    <string name="error_port_in_use_title">پورت‌ها در اشغال‌اند</string>
    <string name="error_port_in_use_body">برنامه دیگری از پورت‌های موردنیاز رله استفاده می‌کند. آن را ببندید و دوباره تلاش کنید.</string>
    <string name="error_service_failed_title">مشکلی پیش آمد</string>
    <string name="error_service_failed_body">اشتراک‌گذاری به‌طور غیرمنتظره متوقف شد. دوباره شروع کنید.</string>
    <string name="error_hotspot_lost_title">اتصال هات‌اسپات قطع شد</string>
    <string name="error_hotspot_lost_body">هات‌اسپات قطع شد و بازنگشت. مطمئن شوید روشن است و دوباره اشتراک‌گذاری را شروع کنید.</string>
    <string name="error_wg_start_title">حالت کامل شروع نشد</string>
    <string name="error_wg_start_body">تونل WireGuard روی این گوشی شروع نشد. حالت سریع را امتحان کنید یا دوباره شروع کنید.</string>
    <string name="action_retry">تلاش دوباره</string>
    <string name="action_dismiss">بستن</string>

    <!-- Battery exemption onboarding (ADR-0003) -->
    <string name="battery_banner_title">اشتراک‌گذاری را زنده نگه دارید</string>
    <string name="battery_banner_body">به رله اجازه دهید بهینه‌سازی باتری را نادیده بگیرد تا با خاموش‌شدن صفحه، اشتراک‌گذاری قطع نشود.</string>
    <string name="battery_banner_allow">اجازه دادن</string>
    <string name="battery_banner_done">اشتراک‌گذاری در پس‌زمینه محافظت می‌شود</string>

