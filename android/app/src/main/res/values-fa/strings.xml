        <item quantity="one">%d دستگاه متصل است</item>
        <item quantity="other">%d دستگاه متصل هستند</item>
    </plurals>
    <string name="scan_hint">با «رله» روی رایانه‌تان اسکن کنید</string>
    <string name="qr_content_description">کد QR جفت‌سازی</string>
    <string name="or_type_code">یا این کد را در رایانه وارد کنید</string>
