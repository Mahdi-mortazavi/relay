<?xml version="1.0" encoding="utf-8"?>
<!--
    The home screen widget.

    RemoteViews only, which rules out Compose and most of what the app's own UI
    is built from — so this is deliberately three text lines and nothing else.
    The whole surface is one click target: a widget with several small targets
    is a widget people mis-tap.

    What it has to answer without being opened: is sharing on, and what do I
    type on the PC. The code is the largest thing here for that reason.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:letterSpacing="0.06"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#FFFFFFFF"
        android:textSize="34sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_pill"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:maxLines="1" />
</LinearLayout>
