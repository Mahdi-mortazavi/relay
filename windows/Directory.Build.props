<Project>

  <!--
    Version stamping for every .NET project under windows/.

    Nothing used to set this. The SDK's default AssemblyVersion is 1.0.0.0, so
    the app's diagnostic report — the only place a Windows user ever sees a
    version — announced "1.0.0" from v1.0.0 through v1.7.0, while Add/Remove
    Programs and the installer filename both said the real number. Field reports
    were therefore untriageable, and the one question that mattered most in
    August 2026 ("are these two downloads the same build?") could not be asked.

    The release workflow passes /p:Version=<tag>. A developer build keeps the
    0.0.0-dev default, which is honest and unmistakable.
  -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <!-- AssemblyVersion and FileVersion are numeric-only: a "-rc1" suffix makes
         the compiler reject them outright, so strip anything after the dash.
         InformationalVersion keeps the full string and is what the app reads. -->
    <_RelayNumericVersion>$(Version.Split('-')[0])</_RelayNumericVersion>
    <AssemblyVersion>$(_RelayNumericVersion).0</AssemblyVersion>
    <FileVersion>$(_RelayNumericVersion).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Company>Relay</Company>
    <Product>Relay</Product>
  </PropertyGroup>

</Project>
