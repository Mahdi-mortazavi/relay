<!--
    The design system. Every value the UI uses lives here; components reference
    tokens and never literals, so the whole app re-tunes from one file.

    Relay's window is a floating popover over DesktopAcrylic. That material is
    the glass layer, and it is the ONLY glass in the app — nothing nested, no
    glass on content. Everything drawn on top is opaque-enough surface or text,
    which is what keeps it legible over an arbitrary wallpaper.

    The palette is deliberately dark-only. The window floats over a translucent
    backdrop with its own scrim, so it reads as one consistent object regardless
    of the desktop theme, and every foreground pair below was chosen against
    that scrim rather than against a system background that can change.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Color ==========================================================
         Labels and fills at four levels each. One accent, used only for the
         single most important interactive thing on screen. -->

    <Color x:Key="ScrimTopColor">#40101318</Color>
    <Color x:Key="ScrimBottomColor">#59080A0E</Color>

    <!-- The solid fallback for the one glass surface in the app. Every glass
         token needs one: with transparency effects turned off there is no
         backdrop behind the scrim, and a 25%-alpha gradient over nothing is a
         window you can see the desktop through. Darker than the scrim on
         purpose, so the same foreground pairs keep their contrast. -->
    <SolidColorBrush x:Key="WindowSolidBrush" Color="#FF12161D" />

    <SolidColorBrush x:Key="LabelPrimary"   Color="#F5FFFFFF" />
    <SolidColorBrush x:Key="LabelSecondary" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="LabelTertiary"  Color="#8AFFFFFF" />
    <SolidColorBrush x:Key="LabelQuaternary" Color="#5CFFFFFF" />

    <SolidColorBrush x:Key="FillPrimary"    Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="FillSecondary"  Color="#14FFFFFF" />
    <SolidColorBrush x:Key="FillTertiary"   Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="FillSunken"     Color="#26000000" />

    <SolidColorBrush x:Key="SeparatorBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="HairlineBrush"  Color="#2EFFFFFF" />

    <!-- One accent. If two things on a screen are accented, one of them is wrong. -->
    <Color x:Key="AccentColor">#4ADFBF</Color>
    <SolidColorBrush x:Key="AccentBrush"        Color="#4ADFBF" />
    <SolidColorBrush x:Key="AccentSoftBrush"    Color="#334ADFBF" />
    <SolidColorBrush x:Key="AccentFaintBrush"   Color="#1A4ADFBF" />
    <SolidColorBrush x:Key="OnAccentBrush"      Color="#05201B" />

    <SolidColorBrush x:Key="WarningBrush"     Color="#F5B95F" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#1FF5B95F" />
    <SolidColorBrush x:Key="DangerBrush"      Color="#FF7A75" />
    <SolidColorBrush x:Key="DangerSoftBrush"  Color="#1FFF7A75" />

    <!-- Interaction overlays, applied over whatever the control's own fill is. -->
    <SolidColorBrush x:Key="OverlayHover"   Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="OverlayPressed" Color="#26000000" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#CC4ADFBF" />

    <!-- ===== Type ===========================================================
         Segoe UI Variable is the Windows system face; Display is drawn for
         large sizes and Text for small, which is the same optical-size idea as
         SF Pro Display / Text. Tracking tightens as size grows. -->

    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="FontText">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>

    <x:Double x:Key="SizeTitle">21</x:Double>
    <x:Double x:Key="SizeHeadline">17</x:Double>
    <x:Double x:Key="SizeBody">14.5</x:Double>
    <x:Double x:Key="SizeCallout">13.5</x:Double>
    <x:Double x:Key="SizeFootnote">12.5</x:Double>
    <x:Double x:Key="SizeCaption">11.5</x:Double>
    <x:Double x:Key="SizeCode">25</x:Double>

    <!-- Tracking is in 1/1000 em. Negative on display sizes, ~0 at body,
         positive on the smallest text so it does not clot. -->
    <x:Int32 x:Key="TrackTitle">-15</x:Int32>
    <x:Int32 x:Key="TrackHeadline">-8</x:Int32>
    <x:Int32 x:Key="TrackBody">0</x:Int32>
    <x:Int32 x:Key="TrackCaption">12</x:Int32>

    <!-- ===== Shape ==========================================================
         Concentricity: a child's radius is the parent's minus the padding
         between them, so curves stay parallel instead of drifting. -->

    <x:Double x:Key="RadiusWindow">12</x:Double>
    <x:Double x:Key="RadiusCard">16</x:Double>
    <x:Double x:Key="RadiusControl">12</x:Double>
    <x:Double x:Key="RadiusPill">24</x:Double>
    <CornerRadius x:Key="CardCorner">16</CornerRadius>
    <CornerRadius x:Key="ControlCorner">12</CornerRadius>
    <CornerRadius x:Key="PillCorner">24</CornerRadius>
    <CornerRadius x:Key="SunkenCorner">10</CornerRadius>

    <!-- ===== Spacing: 4pt grid ============================================== -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">20</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space8">32</x:Double>

    <Thickness x:Key="WindowPadding">20,16,20,18</Thickness>

    <!-- Pointer targets never go below 44px, whatever the label size. -->
    <x:Double x:Key="TargetMin">44</x:Double>
    <x:Double x:Key="ButtonHeight">46</x:Double>

    <!-- ===== Controls =======================================================
         Two button roles only, and they must not look interchangeable: the
         accent one is the thing to do, the plain one is the way out. A third
         "quiet" role carries destructive/secondary text actions. -->

    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource PillCorner}" />
        <Setter Property="Height" Value="{StaticResource ButtonHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource TargetMin}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- Focus indication is the framework's own visual, re-coloured to the
             accent and pushed outside the fill. Drawing a ring inside the
             template instead would depend on Button raising a "Focused" visual
             state, and a keyboard user losing their place is not something to
             stake on that: this path is rendered by the focus manager itself. -->
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource FocusRingBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border x:Name="Overlay"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Background="Transparent" />
                                <ContentPresenter x:Name="Content"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  Content="{TemplateBinding Content}" />
                            </Grid>
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Overlay.Background" Value="{StaticResource OverlayHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Overlay.Background" Value="{StaticResource OverlayPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Bd.Opacity" Value="0.35" />
                                        <Setter Target="Content.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one thing to do on this screen. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- The way out, or the lesser of two paths. Visibly recessive. -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource FillPrimary}" />
        <Setter Property="Foreground" Value="{StaticResource LabelPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- Text-weight action: no fill at all, so it cannot compete with either. -->
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource LabelSecondary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="{StaticResource SizeCallout}" />
        <Setter Property="Height" Value="{StaticResource TargetMin}" />
    </Style>

    <!--
        Caption controls. Relay draws its own: the window is created with
        SetBorderAndTitleBar(true, false), so there is no system caption and
        therefore no close button — which is exactly how a user came to report
        that the window could not be closed. Escape worked; nothing on screen
        said so.

        Small, quiet, and 32x28 rather than the 44pt touch minimum used
        elsewhere: these are pointer-only affordances on a pointer-only surface,
        and sizing them like primary actions would make the header shout.
    -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource LabelTertiary}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ===== Text roles ===================================================== -->

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource SizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="{StaticResource TrackTitle}" />
        <Setter Property="Foreground" Value="{StaticResource LabelPrimary}" />
    </Style>

    <Style x:Key="HeadlineText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource SizeHeadline}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="{StaticResource TrackHeadline}" />
        <Setter Property="Foreground" Value="{StaticResource LabelPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource LabelSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <Style x:Key="FootnoteText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="{StaticResource SizeFootnote}" />
        <Setter Property="Foreground" Value="{StaticResource LabelTertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="{StaticResource SizeCaption}" />
        <Setter Property="CharacterSpacing" Value="{StaticResource TrackCaption}" />
        <Setter Property="Foreground" Value="{StaticResource LabelQuaternary}" />
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource SizeFootnote}" />
        <Setter Property="Foreground" Value="{StaticResource LabelTertiary}" />
    </Style>

</ResourceDictionary>
