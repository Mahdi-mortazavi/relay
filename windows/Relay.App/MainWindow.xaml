<Window
    x:Class="Relay.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        A tray popover. The window's DesktopAcrylic backdrop is the glass layer
        and the only one: the scrim below sits directly on it, and nothing
        inside is translucent over anything else. Nested glass is what turns a
        material into mud.

        Layout is three rows — header, the one state that is currently true, and
        Advanced. The middle row sizes to its content and the window follows, so
        the idle screen is a small card rather than a tall panel with a hole in
        the middle of it.
    -->
    <Grid x:Name="Root" Padding="{StaticResource WindowPadding}">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource ScrimTopColor}" Offset="0" />
                <GradientStop Color="{StaticResource ScrimBottomColor}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!--
            Everything scrolls.

            The window sizes itself to its content but is capped twice: by
            MaxPopupHeight, and again by the monitor's work area, which on a
            short screen or at 175% scaling is the smaller of the two. Without a
            scroller, content past that cap was simply cut off with no way to
            reach it. Expanding Advanced pushed the log, the version and the
            buttons under the bottom edge, and the window is deliberately not
            resizable, so there was no way to get them back.

            This is the outer one. The log keeps its own fixed-height scroller
            inside, so a long log scrolls within its box instead of stretching
            the window to the height of the session's history.

            The right padding is the scrollbar's gutter. WinUI draws this
            scrollbar over the content rather than beside it, so without a
            reserved lane it landed on top of the connected pill and cut it in
            half. ResizeToContent measures at the same reduced width, so the
            height it computes is the height the content actually needs.
        -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
            <Grid x:Name="Content" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

        <!-- ===== Header: identity, live state, and the window's own controls ===== -->
        <Grid Grid.Row="0" Margin="2,0,0,18" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TitleText" Grid.Column="0" Text="Relay"
                       Style="{StaticResource TitleText}" VerticalAlignment="Center" />

            <!-- A dot alone says "something is a colour". Pairing it with a word
                 means a glance answers "what is happening" without decoding hue,
                 which also stops colour from being the only carrier of state. -->
            <Border Grid.Column="1" x:Name="StatusChip"
                    CornerRadius="{StaticResource PillCorner}"
                    Background="{StaticResource FillTertiary}"
                    Padding="10,5,12,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{StaticResource LabelQuaternary}" />
                    <TextBlock x:Name="StatusChipText" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- The window's own caption controls. There is no system title bar
                 (SetBorderAndTitleBar(true, false)), so without these the only
                 ways out were Escape and clicking away — and clicking away stops
                 working once a connection is up, because the popover deliberately
                 stays put while anything is in progress. A user reported the
                 window as unclosable, and they were describing exactly this.

                 Close puts Relay in the tray rather than quitting: the tunnel
                 belongs to this process, and a close button that silently killed
                 a live connection would be a worse surprise than no button.
                 Exit, which really does quit, stays on the tray menu. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                        VerticalAlignment="Center" Margin="6,0,0,0">
                <Button x:Name="MinimiseButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="OnMinimiseClick" />
                <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE8BB;" Click="OnCloseClick" />
            </StackPanel>
        </Grid>

        <!-- ===== State: exactly one of these is visible ===== -->
        <Grid Grid.Row="1" x:Name="StateHost" MinHeight="212">

            <!-- Idle ────────────────────────────────────────-->
            <StackPanel x:Name="IdlePanel" VerticalAlignment="Center" Spacing="10">
                <TextBlock x:Name="IdleHeadline" Style="{StaticResource HeadlineText}" />
                <TextBlock x:Name="IdleBody" Style="{StaticResource FootnoteText}"
                           Margin="6,0,6,6" />

                <!-- Phones that are already announcing themselves, offered
                     before anything has to be typed or aimed at a camera. The
                     app has known about them since it started; hiding them
                     behind "enter a code" asked people to read two digits off a
                     screen the app was already looking at. One click is the
                     whole pairing when this list is not empty. -->
                <StackPanel x:Name="IdleFoundPanel" Spacing="6" Visibility="Collapsed">
                    <TextBlock x:Name="IdleFoundHeader" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource LabelTertiary}"
                               HorizontalAlignment="Center" />
                    <StackPanel x:Name="IdleFoundList" Spacing="6" />
                </StackPanel>

                <!-- One accented action for when the list is empty or the phone
                     is not announcing: scanning is what almost everyone does,
                     so typing a code stays a quiet text action underneath. -->
                <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}"
                        Click="OnScanClick" />
                <Button x:Name="EnterCodeButton" Style="{StaticResource QuietButton}"
                        Click="OnEnterCodeClick" />
            </StackPanel>

            <!-- Scanning ────────────────────────────────────────-->
            <StackPanel x:Name="ScanPanel" VerticalAlignment="Center" Spacing="12"
                        Visibility="Collapsed">
                <Grid Height="252">
                    <Border CornerRadius="{StaticResource CardCorner}"
                            Background="#14171D"
                            BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1">
                        <Border CornerRadius="15">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,340,250" />
                            </Border.Clip>
                            <!-- FlowDirection is pinned. Camera frames are not
                                 UI: on a Persian (or any RTL) Windows the
                                 window's RightToLeft flow mirrors everything in
                                 its subtree, including this Image, so the
                                 preview came out flipped while the Windows
                                 Camera app looked normal (issue #40). -->
                            <Image x:Name="PreviewImage" Stretch="UniformToFill"
                                   FlowDirection="LeftToRight" />
                        </Border>
                    </Border>

                    <!-- An aiming frame. Without one the user has no idea how
                         close to hold the phone, and a preview with nothing
                         drawn on it looks like it is not doing anything. -->
                    <Grid x:Name="Reticle" Width="150" Height="150"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsHitTestVisible="False">
                        <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2.5"
                                CornerRadius="14" Opacity="0.9" />
                    </Grid>
                </Grid>

                <TextBlock x:Name="ScanHintText" Style="{StaticResource FootnoteText}" />
                <Button x:Name="ScanCancelButton" Style="{StaticResource SecondaryButton}"
                        Click="OnCancelClick" />
            </StackPanel>

            <!-- Manual code ────────────────────────────────────────-->
            <StackPanel x:Name="CodePanel" VerticalAlignment="Center" Spacing="12"
                        Visibility="Collapsed">
                <!-- Two characters wide, because two digits is what the phone
                     shows. A box captioned "the 8-character code" in front of a
                     phone showing "42" reads as "these two apps do not go
                     together", and people stop there. -->
                <TextBox x:Name="CodeBox" PlaceholderText="00" MaxLength="2"
                         InputScope="Number"
                         FontSize="{StaticResource SizeCode}"
                         FontFamily="{StaticResource FontMono}"
                         TextAlignment="Center" CharacterSpacing="150"
                         CornerRadius="{StaticResource ControlCorner}" Height="64"
                         Background="{StaticResource FillSecondary}"
                         Foreground="{StaticResource LabelPrimary}"
                         BorderBrush="{StaticResource HairlineBrush}"
                         VerticalContentAlignment="Center"
                         TextChanged="OnCodeChanged" />
                <!-- Says what is wrong with what you typed, as you type it,
                     rather than after you commit to it. -->
                <TextBlock x:Name="CodeHintText" Style="{StaticResource FootnoteText}" />

                <!-- Every phone currently announcing itself, with the code it
                     is showing. Typing is then a convenience rather than the
                     only way in, and the two screens can be checked against
                     each other without trusting either app's prose. Rows are
                     built in code; see PopulateFoundList. -->
                <StackPanel x:Name="FoundPanel" Spacing="6" Visibility="Collapsed">
                    <TextBlock x:Name="FoundHeader" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource LabelTertiary}" />
                    <StackPanel x:Name="FoundList" Spacing="6" />
                </StackPanel>

                <Button x:Name="CodeConnectButton" Style="{StaticResource PrimaryButton}"
                        IsEnabled="False" Click="OnCodeConnectClick" />
                <!-- The long code is still accepted, for a phone that could not
                     announce itself at all. Named by what the user would be
                     looking at rather than by its length. -->
                <HyperlinkButton x:Name="CodeModeLink" HorizontalAlignment="Center"
                                 Click="OnCodeModeClick" />
                <Button x:Name="CodeCancelButton" Style="{StaticResource QuietButton}"
                        Click="OnCancelClick" />
            </StackPanel>

            <!-- Working ────────────────────────────────────────-->
            <StackPanel x:Name="BusyPanel" VerticalAlignment="Center" Spacing="16"
                        Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="34" Height="34"
                              Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="BusyText" Style="{StaticResource BodyText}" />
                <TextBlock x:Name="BusyDetailText" Style="{StaticResource FootnoteText}" />
                <!-- Anything that can take time needs a way out of it — and the
                     way out has to actually undo the attempt, not just stop
                     looking at it. -->
                <Button x:Name="BusyCancelButton" Style="{StaticResource QuietButton}"
                        Click="OnBusyCancelClick" />
            </StackPanel>

            <!-- Connected ────────────────────────────────────────-->
            <StackPanel x:Name="ConnectedPanel" VerticalAlignment="Center" Spacing="8"
                        Visibility="Collapsed">
                <Grid HorizontalAlignment="Center" Width="76" Height="76" Margin="0,0,0,8">
                    <Ellipse x:Name="ConnectedHalo" Width="76" Height="76"
                             Fill="{StaticResource AccentFaintBrush}" />
                    <Ellipse Width="46" Height="46" Fill="{StaticResource AccentSoftBrush}" />
                    <Ellipse x:Name="ConnectedDot" Width="18" Height="18"
                             Fill="{StaticResource AccentBrush}" />
                </Grid>

                <TextBlock x:Name="ConnectedText" Style="{StaticResource HeadlineText}" />
                <TextBlock x:Name="ConnectedDetailText" Style="{StaticResource MonoText}"
                           HorizontalAlignment="Center" />

                <!-- What the tunnel is carrying, from the adapter's own
                     counters. Rates on top because they answer "is it working
                     right now"; totals and latency underneath because they
                     answer "has it been working". -->
                <Border CornerRadius="{StaticResource SunkenCorner}"
                        Background="{StaticResource FillSunken}"
                        Padding="14,10" Margin="0,10,0,0">
                    <Grid ColumnSpacing="10" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="StatDownRate" Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource MonoText}" />
                        <TextBlock x:Name="StatUpRate" Grid.Row="0" Grid.Column="1"
                                   Style="{StaticResource MonoText}"
                                   HorizontalAlignment="Right" />

                        <TextBlock x:Name="StatDownTotal" Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource LabelTertiary}" />
                        <TextBlock x:Name="StatUpTotal" Grid.Row="1" Grid.Column="1"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource LabelTertiary}"
                                   HorizontalAlignment="Right" />

                        <TextBlock x:Name="StatLatency" Grid.Row="2" Grid.Column="0"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource LabelTertiary}" />
                        <TextBlock x:Name="StatDuration" Grid.Row="2" Grid.Column="1"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource LabelTertiary}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <Border x:Name="ReconnectingBanner" Visibility="Collapsed"
                        CornerRadius="{StaticResource SunkenCorner}"
                        Background="{StaticResource WarningSoftBrush}"
                        Padding="12,8" Margin="0,8,0,0">
                    <TextBlock x:Name="ReconnectingText" Style="{StaticResource FootnoteText}"
                               Foreground="{StaticResource WarningBrush}" />
                </Border>

                <Button x:Name="DisconnectButton" Style="{StaticResource SecondaryButton}"
                        Margin="0,14,0,0" Click="OnDisconnectClick" />
            </StackPanel>

            <!-- Error ────────────────────────────────────────-->
            <StackPanel x:Name="ErrorPanel" VerticalAlignment="Center" Spacing="12"
                        Visibility="Collapsed">
                <Grid HorizontalAlignment="Center" Width="60" Height="60" Margin="0,0,0,4">
                    <Ellipse Width="60" Height="60" Fill="{StaticResource DangerSoftBrush}" />
                    <Ellipse Width="14" Height="14" Fill="{StaticResource DangerBrush}" />
                </Grid>
                <!-- Errors get a headline that names the problem and a body that
                     says what to do about it, instead of one undifferentiated
                     paragraph the user has to parse under stress. -->
                <TextBlock x:Name="ErrorTitle" Style="{StaticResource HeadlineText}" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource FootnoteText}"
                           Margin="4,0,4,0" />
                <Button x:Name="ErrorPrimaryButton" Style="{StaticResource PrimaryButton}"
                        Margin="0,8,0,0" Click="OnErrorPrimaryClick" />
                <Button x:Name="ErrorDismissButton" Style="{StaticResource QuietButton}"
                        Click="OnDismissClick" />
            </StackPanel>
        </Grid>

        <!-- ===== Advanced: present, but never in the way ===== -->
        <Expander x:Name="AdvancedExpander" Grid.Row="2" Margin="0,16,0,0"
                  Background="Transparent" BorderBrush="Transparent"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <TextBlock x:Name="AdvancedHeader" Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource LabelTertiary}" />
            </Expander.Header>
            <StackPanel Spacing="12" Padding="2,8,2,2">
                <!-- Which build this is, where a user can read it out. Two
                     people comparing a stale download against a current one
                     could not previously tell that was what they were doing,
                     and the diagnostic report they sent claimed 1.0.0. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AdvancedVersionLabel" Style="{StaticResource CaptionText}"
                               Grid.Column="0" VerticalAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0" />
                    <TextBlock x:Name="AdvancedVersionValue" Grid.Column="1" HorizontalAlignment="Right"
                               Style="{StaticResource MonoText}"
                               IsTextSelectionEnabled="True"
                               FlowDirection="LeftToRight"
                               Foreground="{StaticResource LabelSecondary}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AdvancedAddressLabel" Style="{StaticResource CaptionText}"
                               Grid.Column="0" VerticalAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0" />
                    <TextBlock x:Name="AdvancedAddressValue" Grid.Column="1" HorizontalAlignment="Right"
                               Style="{StaticResource MonoText}"
                               Foreground="{StaticResource LabelSecondary}" />
                </Grid>
                <!-- Start with Windows. A tray app that shares a connection is
                     only useful if it is already there when you need it, and the
                     per-user Run key needs no elevation to set. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AdvancedStartupLabel" Style="{StaticResource CaptionText}"
                               Grid.Column="0" VerticalAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0" />
                    <ToggleSwitch x:Name="AdvancedStartupToggle" Grid.Column="1" HorizontalAlignment="Right"
                                  MinWidth="0" Margin="0,-6,0,-6"
                                  Toggled="OnStartupToggled" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AdvancedLogsLabel" Style="{StaticResource CaptionText}"
                               Grid.Column="0" VerticalAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <HyperlinkButton x:Name="AdvancedLogsShare" Padding="0"
                                         Click="OnShareLogsClick" />
                        <HyperlinkButton x:Name="AdvancedLogsClear" Padding="0"
                                         Click="OnClearLogsClick" />
                    </StackPanel>
                </Grid>
                <Border CornerRadius="{StaticResource SunkenCorner}"
                        Background="{StaticResource FillSunken}" Padding="12,10">
                    <ScrollViewer Height="116" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogText" FontFamily="{StaticResource FontMono}"
                                   FontSize="11" TextWrapping="NoWrap"
                                   Foreground="{StaticResource LabelTertiary}" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Expander>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
