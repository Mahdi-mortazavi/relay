<!--
    RequestedTheme is Dark because the design system is dark-only, and until now
    nothing said so to the framework. Two things went wrong as a result, both
    visible in the E2E screenshot:

    1. Every stock control — Expander, TextBox, ProgressRing, ScrollViewer — drew
       its light-theme chrome underneath our dark palette.
    2. DesktopAcrylic takes its tint and, more importantly, its *fallback* colour
       from the content's theme. Where acrylic cannot composite (a VM, a remote
       session, transparency turned off) it fell back to light grey, and this
       app's text is translucent white. The window became close to unreadable on
       exactly the machines least able to render the effect.

    Declaring the theme is the honest fix: the palette really is dark-only, so
    the framework should be told rather than left to guess from the desktop.
-->
<Application
    x:Class="Relay.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- The design system. Merged after the framework's dictionary so
                     our tokens win where the names collide. -->
                <ResourceDictionary Source="ms-appx:///Styles/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
