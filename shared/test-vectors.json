    "clientTunnelIp": "10.13.37.2",
    "ipc": "private_key=3f6189d5a5906f952bacb34b97f8b0617fc003c2ba0bf052f4bd5ed899dec29a\nlisten_port=51820\npublic_key=6a531cd4a6884f0fef6d85b73e6354b9beacc0ff1dfabc372347eed3515579f7\nallowed_ip=10.13.37.2/32\n"
